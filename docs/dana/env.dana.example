# Dana / ICS WebUI theme + magic variant configuration
# Copy into deploy compose env or container environment.

# Main chat shell: ics-dark | ics-maroon | ics-gauge | ics-stair | ics-mono | vanilla
DANA_THEME_ID=ics-dark

# Also accepted via Open WebUI DEFAULT_INTERFACE_SETTINGS JSON:
# DEFAULT_INTERFACE_SETTINGS={"dana_theme_id":"ics-dark","dana_magic_variants":{"gauge":"ring","timeline":"vertical","table":"striped","list":"accordion","logo":"white"}}

# Optional Vite build-time default (frontend):
# VITE_DANA_THEME_ID=ics-dark

# Magic skins (overridable per token via params.variant, or theme pack magic_variants)
# gauge: ring | arc | hero
# timeline: vertical | horizontal | compact
# table: striped | cards | dense
# list: accordion | grid | chips
# logo: white | maroon | gauge
DANA_MAGIC_GAUGE=ring
DANA_MAGIC_TIMELINE=vertical
DANA_MAGIC_TABLE=striped
DANA_MAGIC_LIST=accordion
DANA_MAGIC_LOGO=white
